# The application reads process environment variables; it does not load this file.
GAME_REVIEW_ANALYZER_ENV=development
GAME_REVIEW_ANALYZER_DATABASE=data/game-review-analyzer.sqlite3
GAME_REVIEW_ANALYZER_FRONTEND_DIST=../frontend/dist
GAME_REVIEW_ANALYZER_STEAM_COUNTRY=US

# Optional. Create a standard Steam Web API key and keep the real value out of Git.
GAME_REVIEW_ANALYZER_STEAM_WEB_API_KEY=
